{
  "expo": {
    "name": "Daily",
    "slug": "daily",
    "scheme": "daily",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8F4",
    "android": {
      "package": "com.aaronalex.daily",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 132, "backgroundColor": "#FBF8F4", "resizeMode": "contain" }],
      "expo-sqlite",
      "expo-font",
      "expo-background-task",
      "expo-sharing",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#F6B35E" }],
      "./plugins/withReleaseSigning",
      "./plugins/withSplashSquare"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
