{
  "name": "worksight",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @worksight/agent dev",
    "build": "pnpm --filter @worksight/agent build",
    "test": "pnpm --workspace-concurrency=1 --filter @worksight/core --filter @worksight/agent --filter @worksight/consumer --filter @worksight/daily-ai --filter @worksight/mobile test",
    "test:rls": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "strip-ansi": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "@bacons/apple-targets@5.0.0": "patches/@bacons__apple-targets@5.0.0.patch"
    }
  }
}
